# ==============================================================================
# Supabase & Application Environment Configuration
# ==============================================================================

# 1. Supabase PostgreSQL Database Connection
# From Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.abcdefghijk:YourPassword123@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# When set, the application automatically connects to your Supabase PostgreSQL database
# and seeds the tables if empty. Leave commented or empty to use local SQLite database.
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 2. Supabase API Credentials (Project Settings -> API)
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_KEY=[ANON_KEY_OR_SERVICE_ROLE_KEY]

# 3. Frontend Client Credentials (used by Vite frontend)
# VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# VITE_SUPABASE_ANON_KEY=[ANON_KEY]
# VITE_API_BASE_URL=http://localhost:8000

# 4. Environment & Security
AICTE_ENV=demo
# AICTE_JWT_SECRET=
# AICTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
